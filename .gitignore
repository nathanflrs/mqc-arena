# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Env — glob large: attrape .env, .env.local, .envtTe, .env.save…
# Ne PAS restreindre à `.env.*` : un fichier comme `.envtTe` échappe au motif
# et se retrouve trackable (incident 2026-08-02).
.env*
!.env.example

# Sauvegardes locales (ex. logs/decisions.csv.bak)
*.bak

# Logs sensibles
# logs/shadow_signals.csv  # tracked — shadow mode accumulates signals daily

# Comptes dashboard (mots de passe hashés)
src/dashboard/users.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Cache de données du backtest système : les parquet sont volumineux et
# régénérables (--refresh), mais le manifeste identifie le snapshot et doit
# être versionné — c'est lui qui permet de dire si un résultat publié a été
# produit sur les mêmes données.
logs/backtest_cache/*
!logs/backtest_cache/manifest.json

# Signaux du replay (volumineux, régénérable via scripts/measure_agent_edge.py)
logs/agent_signals.parquet
logs/cta_signals.parquet

# Cache EDGAR : volumineux et régénérable (les dépôts passés ne changent pas).
logs/fundamentals_cache/

# Verrou d'exécution — état d'un processus, jamais versionné.
logs/run.lock

# Notifications : clé privée VAPID et abonnements des appareils.
# Régénérer les clés couperait tous les appareils inscrits, sans erreur visible.
logs/vapid_keys.json
logs/push_subscriptions.json

# Cache univers : révisions Wikipédia figées, régénérables.
logs/universe_cache/

# Instantané de prix de l'univers élargi : volumineux, régénérable.
# Le manifeste est versionné — c'est lui qui documente la couverture réelle.
logs/universe_snapshot/*
!logs/universe_snapshot/manifest.json
