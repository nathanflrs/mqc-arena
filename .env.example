# Milan Capital — configuration template.
#
# Copy to `.env` and fill in your own values. `.env` is git-ignored by a
# deliberately broad glob (`.env*`): a file named `.envSomething` once escaped a
# narrower pattern and became trackable. Never commit real credentials — an
# earlier `.env` containing a Telegram bot token reached this repository's
# public history on 2026-06-03.

# ── Execution locks ───────────────────────────────────────────────────────────
# One of the two arming locks. The other lives in the IB Gateway configuration
# (`ReadOnlyApi`). Closing either one is sufficient to block all orders.
EXECUTION_ENABLED=false

# ── Interactive Brokers ───────────────────────────────────────────────────────
# 4002 = IB Gateway paper, 4001 = IB Gateway live, 7497 = TWS paper.
IBKR_PORT=4002
IBKR_CLIENT_ID=7

# ── Order guards ──────────────────────────────────────────────────────────────
MAX_ORDERS_PER_RUN=5
MAX_NOTIONAL_PCT=0.02
LIMIT_BUFFER_BPS=5
MIN_SCORE_THRESHOLD=0.02

# ── Risk limits ───────────────────────────────────────────────────────────────
# These MUST mirror the defaults in src/config.py. A template that silently
# loosens a stop loss or a cash floor is worse than no template at all.
RISK_MAX_NET_LONG_PCT=0.60
RISK_MAX_SINGLE_POSITION_PCT=0.20
RISK_MIN_CASH_PCT=0.30
RISK_SELL_ONLY_MODE=false
STOP_LOSS_PCT=0.07
MAX_LEVERAGE=1.0

# ── Market data (optional; agents degrade gracefully without them) ────────────
FINNHUB_API_KEY=
FRED_API_KEY=

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Any long random string. Rotating it logs every device out.
SESSION_SECRET=
PORT=8000

# ── Telegram (disabled since 2026-08-13, replaced by Web Push) ────────────────
# Kept only so the legacy code path stays inert rather than crashing.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
